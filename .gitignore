# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# debug logs - NEVER commit logs with tokens
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log
database-debug.log
firebase-debug.*
*.log

# env files - NEVER commit real secrets (except example template)
.env*
!.env.example
!.env.template

# firebase / hosting cache - NEVER commit generated output
.firebase/
.cache/
out/
dist/
build/
coverage/

# vercel / netlify / hosting
.vercel
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts

# OS files
.DS_Store
Thumbs.db

# databases - NEVER commit production data
*.db
*.sqlite
*.sqlite3
*.db-journal

# private keys & credentials - NEVER commit
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
service-account.json
firebase-adminsdk*.json
id_rsa
id_ed25519

# IDE
.vscode/
.idea/
